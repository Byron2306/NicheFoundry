# NicheFoundry Phase 8 audio, host, and performance console
HOST=127.0.0.1
PORT=4173
BODY_LIMIT_BYTES=1048576
# Required when HOST is not loopback.
FOUNDRY_AUTH_TOKEN=

# Persistent storage
FOUNDRY_DATA_DIR=
FOUNDRY_EPISODES_DIR=
FOUNDRY_CUSTOM_STUDIOS_DIR=
FOUNDRY_CUSTOM_CONNECTORS_DIR=

# Research
# Use a descriptive Wikimedia-compatible User-Agent, ideally with a contact URL or email.
FOUNDRY_USER_AGENT=NicheFoundry/0.5 (local research tool; contact=you@example.com)
FOUNDRY_MAX_SOURCE_CHARS=30000
# Test-only. Never enable for real production research.
FOUNDRY_ALLOW_OFFLINE_SOURCE_FIXTURES=0

# Connector authentication. Definitions reference these names, never their values.
# Public YouTube topic and competitor discovery.
YOUTUBE_API_KEY=
# Owned-channel YouTube Analytics OAuth refresh flow.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Optional short-lived token fallback for local testing only.
YOUTUBE_ACCESS_TOKEN=
# Resumable media transfer and bounded processing polls.
YOUTUBE_UPLOAD_CHUNK_SIZE=8388608
YOUTUBE_PROCESS_POLL_INTERVAL_MS=3000
YOUTUBE_PROCESS_MAX_ATTEMPTS=20
# Optional. Public GitHub endpoints work without it at lower limits.
GITHUB_TOKEN=

# Question generation
# rules = deterministic claim-bound generator
# ollama = local structured-output generation with deterministic fallback
FOUNDRY_GENERATOR_MODE=rules
FOUNDRY_OLLAMA_STRICT=0
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Render tools
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# Optional FFmpeg speed/quality overrides. Defaults remain proxy=veryfast/CRF28 and final=medium/CRF20.
# FOUNDRY_PROXY_RENDER_PRESET=veryfast
# FOUNDRY_FINAL_RENDER_PRESET=medium
# FOUNDRY_PROXY_RENDER_CRF=28
# FOUNDRY_FINAL_RENDER_CRF=20

# Audio production
# Provider order is imported -> Piper -> ElevenLabs -> local eSpeak reference unless explicitly selected.
# Optional local Piper narration
PIPER_BIN=
PIPER_MODEL_DIR=
PIPER_MODEL_NAME=en_US-lessac-high
PIPER_MODEL_FILE=en_US-lessac-high.onnx
PIPER_CONFIG_FILE=en_US-lessac-high.onnx.json

# Optional local Kokoro narration. Install the runtime with scripts/install_kokoro.sh.
KOKORO_COMMAND=
KOKORO_VOICE=af_heart
KOKORO_LANG_CODE=a
KOKORO_SPEED=1.0

# Optional Voicebox local API. Preferred when you want a packaged local cloning
# stack instead of wiring raw model runtimes by hand.
VOICEBOX_API_URL=http://127.0.0.1:17493
VOICEBOX_PROFILE=
VOICEBOX_ENGINE=qwen
VOICEBOX_MODEL_SIZE=0.6B
VOICEBOX_LANGUAGE=en
VOICEBOX_CLIENT_ID=nichefoundry

# Downstream production adapters remain evidence-blocked until verified files exist.
GAMMA_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional local voice conversion. Build OPENVOICE_REFERENCE_AUDIO from approved
# ElevenLabs samples with `npm run build:voice-reference`, then install OpenVoice.
# Keep this behind Kokoro, Piper, or ElevenLabs unless you specifically want
# tone-color transfer from a weaker base TTS performance.
OPENVOICE_COMMAND=
OPENVOICE_REPO=
OPENVOICE_CHECKPOINT=
OPENVOICE_REFERENCE_AUDIO=
OPENVOICE_LANGUAGE=EN_NEWEST
# eSpeak is a deterministic local reference fallback, not the recommended final production voice.
ESPEAK_BIN=espeak-ng
